{
  "about": "The environment contract every Sensive SDK keeps, configured by the environment alone. `environment` lists environments and, for each, the settings a client must resolve or the variable it must refuse. `checks` lists checks: in a mode, against a checker that behaves one way, what the client sends and what it returns. `failures` lists checks the caller could not build, such as one whose owner lookup failed: in each mode, what the client returns, sending nothing. In a check's env, `$CHECKER` is the URL of the test's own fake checker.",
  "environment": [
    {
      "name": "only the required variables: every default applies",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac"
      },
      "settings": {
        "mode": "ENFORCED",
        "dac_url": "https://dac.example.com/api/dac",
        "environment": "PRODUCTION_DATA",
        "timeout_ms": 5000
      }
    },
    {
      "name": "every variable set",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_ENVIRONMENT": "TEST_DATA",
        "SENSIVE_TIMEOUT_MS": "250",
        "SENSIVE_MODE": "LOG_ONLY"
      },
      "settings": {
        "mode": "LOG_ONLY",
        "dac_url": "https://dac.example.com/api/dac",
        "environment": "TEST_DATA",
        "timeout_ms": 250
      }
    },
    {
      "name": "ENFORCED named explicitly",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_MODE": "ENFORCED"
      },
      "settings": {
        "mode": "ENFORCED",
        "dac_url": "https://dac.example.com/api/dac",
        "environment": "PRODUCTION_DATA",
        "timeout_ms": 5000
      }
    },
    {
      "name": "http is accepted",
      "env": {
        "SENSIVE_DAC_URL": "http://localhost:3010/api/dac"
      },
      "settings": {
        "mode": "ENFORCED",
        "dac_url": "http://localhost:3010/api/dac",
        "environment": "PRODUCTION_DATA",
        "timeout_ms": 5000
      }
    },
    {
      "name": "values are trimmed",
      "env": {
        "SENSIVE_DAC_URL": "  https://dac.example.com/api/dac\n",
        "SENSIVE_ENVIRONMENT": " TEST_DATA ",
        "SENSIVE_TIMEOUT_MS": " 250 ",
        "SENSIVE_MODE": " LOG_ONLY "
      },
      "settings": {
        "mode": "LOG_ONLY",
        "dac_url": "https://dac.example.com/api/dac",
        "environment": "TEST_DATA",
        "timeout_ms": 250
      }
    },
    {
      "name": "an empty value is unset, so the default applies",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_ENVIRONMENT": "",
        "SENSIVE_TIMEOUT_MS": "   ",
        "SENSIVE_MODE": ""
      },
      "settings": {
        "mode": "ENFORCED",
        "dac_url": "https://dac.example.com/api/dac",
        "environment": "PRODUCTION_DATA",
        "timeout_ms": 5000
      }
    },
    {
      "name": "DISABLED needs nothing else",
      "env": {
        "SENSIVE_MODE": "DISABLED"
      },
      "settings": {
        "mode": "DISABLED"
      }
    },
    {
      "name": "DISABLED reads nothing else, so invalid values do not matter",
      "env": {
        "SENSIVE_MODE": "DISABLED",
        "SENSIVE_DAC_URL": "ftp://dac.example.com",
        "SENSIVE_ENVIRONMENT": "STAGING",
        "SENSIVE_TIMEOUT_MS": "soon"
      },
      "settings": {
        "mode": "DISABLED"
      }
    },
    {
      "name": "LOG_ONLY needs the URL",
      "env": {
        "SENSIVE_MODE": "LOG_ONLY"
      },
      "refuses": "SENSIVE_DAC_URL"
    },
    {
      "name": "the URL is required",
      "env": {},
      "refuses": "SENSIVE_DAC_URL"
    },
    {
      "name": "a blank URL is unset",
      "env": {
        "SENSIVE_DAC_URL": "  "
      },
      "refuses": "SENSIVE_DAC_URL"
    },
    {
      "name": "a URL that is not https or http",
      "env": {
        "SENSIVE_DAC_URL": "ftp://dac.example.com/api/dac"
      },
      "refuses": "SENSIVE_DAC_URL"
    },
    {
      "name": "a URL with no scheme",
      "env": {
        "SENSIVE_DAC_URL": "dac.example.com/api/dac"
      },
      "refuses": "SENSIVE_DAC_URL"
    },
    {
      "name": "a URL with no host",
      "env": {
        "SENSIVE_DAC_URL": "https:///api/dac"
      },
      "refuses": "SENSIVE_DAC_URL"
    },
    {
      "name": "the environment is spelled as listed, case included",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_ENVIRONMENT": "test_data"
      },
      "refuses": "SENSIVE_ENVIRONMENT"
    },
    {
      "name": "an environment that is not one of the two",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_ENVIRONMENT": "STAGING"
      },
      "refuses": "SENSIVE_ENVIRONMENT"
    },
    {
      "name": "the mode is spelled as listed, case included",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_MODE": "log_only"
      },
      "refuses": "SENSIVE_MODE"
    },
    {
      "name": "a mode spelled with a dash",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_MODE": "LOG-ONLY"
      },
      "refuses": "SENSIVE_MODE"
    },
    {
      "name": "a mode that is not one of the three",
      "env": {
        "SENSIVE_MODE": "OFF"
      },
      "refuses": "SENSIVE_MODE"
    },
    {
      "name": "a zero timeout",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_TIMEOUT_MS": "0"
      },
      "refuses": "SENSIVE_TIMEOUT_MS"
    },
    {
      "name": "a negative timeout",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_TIMEOUT_MS": "-5"
      },
      "refuses": "SENSIVE_TIMEOUT_MS"
    },
    {
      "name": "a timeout that is not a whole number",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_TIMEOUT_MS": "1.5"
      },
      "refuses": "SENSIVE_TIMEOUT_MS"
    },
    {
      "name": "a timeout with a unit",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_TIMEOUT_MS": "5s"
      },
      "refuses": "SENSIVE_TIMEOUT_MS"
    },
    {
      "name": "a timeout with a sign",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_TIMEOUT_MS": "+250"
      },
      "refuses": "SENSIVE_TIMEOUT_MS"
    }
  ],
  "checks": [
    {
      "name": "ENFORCED: the checker allows",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER",
        "SENSIVE_ENVIRONMENT": "TEST_DATA"
      },
      "checker": "ALLOW",
      "waits": true,
      "sent": {
        "mode": "ENFORCED",
        "environment": "TEST_DATA"
      },
      "result": {
        "decision": "ALLOW",
        "token": true,
        "source": "CHECKER"
      }
    },
    {
      "name": "ENFORCED: the checker denies",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER"
      },
      "checker": "DENY",
      "waits": true,
      "sent": {
        "mode": "ENFORCED",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "DENY",
        "token": true,
        "source": "CHECKER"
      }
    },
    {
      "name": "ENFORCED: the checker does not answer within the timeout",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER",
        "SENSIVE_TIMEOUT_MS": "50"
      },
      "checker": "HANG",
      "waits": true,
      "sent": {
        "mode": "ENFORCED",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "DENY",
        "token": false,
        "source": "TIMEOUT"
      }
    },
    {
      "name": "ENFORCED: the checker answers with an error",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER"
      },
      "checker": "ERROR",
      "waits": true,
      "sent": {
        "mode": "ENFORCED",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "DENY",
        "token": false,
        "source": "FAILURE"
      }
    },
    {
      "name": "ENFORCED: the checker's answer carries no decision",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER"
      },
      "checker": "NO_DECISION",
      "waits": true,
      "sent": {
        "mode": "ENFORCED",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "DENY",
        "token": false,
        "source": "FAILURE"
      }
    },
    {
      "name": "LOG_ONLY: the checker would allow",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER",
        "SENSIVE_MODE": "LOG_ONLY",
        "SENSIVE_ENVIRONMENT": "TEST_DATA"
      },
      "checker": "ALLOW",
      "waits": false,
      "sent": {
        "mode": "LOG_ONLY",
        "environment": "TEST_DATA"
      },
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    },
    {
      "name": "LOG_ONLY: the checker would deny",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER",
        "SENSIVE_MODE": "LOG_ONLY"
      },
      "checker": "DENY",
      "waits": false,
      "sent": {
        "mode": "LOG_ONLY",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    },
    {
      "name": "LOG_ONLY: the checker does not answer",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER",
        "SENSIVE_MODE": "LOG_ONLY",
        "SENSIVE_TIMEOUT_MS": "50"
      },
      "checker": "HANG",
      "waits": false,
      "sent": {
        "mode": "LOG_ONLY",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    },
    {
      "name": "LOG_ONLY: the checker answers with an error",
      "env": {
        "SENSIVE_DAC_URL": "$CHECKER",
        "SENSIVE_MODE": "LOG_ONLY"
      },
      "checker": "ERROR",
      "waits": false,
      "sent": {
        "mode": "LOG_ONLY",
        "environment": "PRODUCTION_DATA"
      },
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    },
    {
      "name": "DISABLED: nothing is sent",
      "env": {
        "SENSIVE_MODE": "DISABLED"
      },
      "checker": "ALLOW",
      "waits": false,
      "sent": null,
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    }
  ],
  "failures": [
    {
      "name": "ENFORCED: a check that could not be built is DENY",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac"
      },
      "result": {
        "decision": "DENY",
        "token": false,
        "source": "FAILURE"
      }
    },
    {
      "name": "LOG_ONLY: a check that could not be built is ALLOW",
      "env": {
        "SENSIVE_DAC_URL": "https://dac.example.com/api/dac",
        "SENSIVE_MODE": "LOG_ONLY"
      },
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    },
    {
      "name": "DISABLED: a check that could not be built is ALLOW",
      "env": {
        "SENSIVE_MODE": "DISABLED"
      },
      "result": {
        "decision": "ALLOW",
        "token": false,
        "source": "MODE"
      }
    }
  ]
}
